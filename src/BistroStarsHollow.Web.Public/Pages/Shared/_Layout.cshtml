@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var appUrl = Configuration["AppUrl"] ?? "https://localhost:5001";
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Bistro Stars Hollow - Craft pivo, skvělé jídlo a jedinečná atmosféra ve Frenštátě pod Radhoštěm." />
    <title>@ViewData["Title"] - Bistro Stars Hollow</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Header -->
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    <span class="brand-text">Bistro Stars Hollow</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Index" ? "active" : "")" asp-page="/Index">
                                Domů
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(currentPage == "/Menu" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Menu
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Menu" asp-fragment="jidelni-listek"><i class="bi bi-egg-fried me-2"></i>Jídelní lístek</a></li>
                                <li><a class="dropdown-item" asp-page="/Menu" asp-fragment="napojovy-listek"><i class="bi bi-cup-straw me-2"></i>Nápojový lístek</a></li>
                                <li><a class="dropdown-item" asp-page="/Menu" asp-fragment="vodni-dymky"><i class="bi bi-cloud me-2"></i>Vodní dýmky</a></li>
                                <li><a class="dropdown-item" asp-page="/Menu" asp-fragment="caje"><i class="bi bi-cup-hot me-2"></i>Čaje</a></li>
                                <li><a class="dropdown-item" asp-page="/Menu" asp-fragment="prodej"><i class="bi bi-bag me-2"></i>Prodej</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Piva
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Beers/BottledBeers"><i class="bi bi-box-seam me-2"></i>Piva v lednici</a></li>
                                <li><a class="dropdown-item" asp-page="/Beers/DraftBeers"><i class="bi bi-cup-fill me-2"></i>Piva na čepu</a></li>
                                <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.1);" /></li>
                                <li><a class="dropdown-item" asp-page="/Beers/Breweries"><i class="bi bi-building me-2"></i>Oblíbené pivovary</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Gallery" ? "active" : "")" asp-page="/Gallery">
                                Fotogalerie
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Contact" ? "active" : "")" asp-page="/Contact">
                                Kde nás najdete
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/About" ? "active" : "")" asp-page="/About">
                                O nás
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <div class="lang-switch">
                                <a class="lang-pill @(currentCulture == "cs" ? "active" : "")" href="?culture=cs&ui-culture=cs">CZ</a>
                                <a class="lang-pill @(currentCulture == "en" ? "active" : "")" href="?culture=en&ui-culture=en">EN</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-main">
            <div class="container">
                <div class="row g-4 g-lg-5">
                    <!-- Brand & Description -->
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-brand">Bistro Stars Hollow</div>
                        <p class="footer-desc">
                            Craft pivo, domácí kuchyně a jedinečná atmosféra v srdci Frenštátu pod Radhoštěm.
                        </p>
                        <div class="footer-social">
                            <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <div class="col-lg-2 col-md-6">
                        <h6>Navigace</h6>
                        <ul class="footer-links">
                            <li><a asp-page="/Index">Domů</a></li>
                            <li><a asp-page="/Menu">Menu</a></li>
                            <li><a asp-page="/Gallery">Fotogalerie</a></li>
                            <li><a asp-page="/About">O nás</a></li>
                        </ul>
                    </div>

                    <!-- Opening Hours -->
                    <div class="col-lg-3 col-md-6">
                        <h6>Otevírací doba</h6>
                        @await Component.InvokeAsync("OpeningHours")
                    </div>

                    <!-- Contact -->
                    <div class="col-lg-3 col-md-6">
                        <h6>Kontakt</h6>
                        <ul class="footer-links">
                            <li>
                                <a href="#">
                                    <i class="bi bi-geo-alt"></i>Frenštát pod Radhoštěm
                                </a>
                            </li>
                            <li>
                                <a href="tel:+420000000000">
                                    <i class="bi bi-telephone"></i>+420 000 000 000
                                </a>
                            </li>
                            <li>
                                <a href="mailto:info@bistrosh.cz">
                                    <i class="bi bi-envelope"></i>info@bistrosh.cz
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <p class="footer-bottom-text">
                        &copy; @DateTime.Now.Year Bistro Stars Hollow. Všechna práva vyhrazena.
                    </p>
                    <div class="d-flex gap-3 align-items-center">
                        <a href="#" class="footer-bottom a">Cookies</a>
                        <a href="#">Ochrana osobních údajů</a>
                        <span class="d-none d-md-inline" style="color: rgba(255,255,255,0.15);">|</span>
                        <a href="@appUrl" class="d-none d-md-inline">
                            <i class="bi bi-lock me-1"></i>Pro zaměstnance
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/public.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

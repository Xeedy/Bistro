@page
@model BistroStarsHollow.Web.Public.Pages.ReservationCancelModel
@{
    ViewData["Title"] = "Zrušení rezervace";
}

<section class="py-5 section-light">
    <div class="container">
        <h1 class="section-title section-title-center">Zrušení rezervace</h1>
        <hr class="section-divider section-divider-center" />
    </div>
</section>

<section class="py-5 section-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="menu-card text-center">
                    @if (Model.CancelSuccess == true)
                    {
                        <div class="mb-4">
                            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                        </div>
                        <h3 class="mb-3">Rezervace zrušena</h3>
                        <p class="text-muted mb-4">
                            Vaše rezervace byla úspěšně zrušena. Děkujeme, že jste nás informovali.
                        </p>
                        <a asp-page="Reservation" class="btn btn-primary">
                            <i class="bi bi-calendar-plus me-1"></i> Vytvořit novou rezervaci
                        </a>
                    }
                    else if (Model.CancelSuccess == false)
                    {
                        <div class="mb-4">
                            <i class="bi bi-exclamation-circle-fill text-danger" style="font-size: 4rem;"></i>
                        </div>
                        <h3 class="mb-3">Zrušení se nezdařilo</h3>
                        <p class="text-danger mb-4">@Model.ErrorMessage</p>
                        <a asp-page="Index" class="btn btn-primary">
                            <i class="bi bi-house me-1"></i> Zpět na hlavní stránku
                        </a>
                    }
                    else if (string.IsNullOrEmpty(Model.Token))
                    {
                        <div class="mb-4">
                            <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 4rem;"></i>
                        </div>
                        <h3 class="mb-3">Chybí token</h3>
                        <p class="text-muted mb-4">
                            Pro zrušení rezervace je potřeba platný odkaz s tokenem.
                        </p>
                        <a asp-page="Index" class="btn btn-primary">
                            <i class="bi bi-house me-1"></i> Zpět na hlavní stránku
                        </a>
                    }
                    else
                    {
                        <div class="mb-4">
                            <i class="bi bi-question-circle-fill text-warning" style="font-size: 4rem;"></i>
                        </div>
                        <h3 class="mb-3">Opravdu chcete zrušit rezervaci?</h3>
                        <p class="text-muted mb-4">
                            Tato akce je nevratná. Po zrušení bude stůl uvolněn pro ostatní hosty.
                        </p>
                        <form method="post">
                            <input type="hidden" asp-for="Token" />
                            <button type="submit" class="btn btn-danger btn-lg me-2">
                                <i class="bi bi-x-circle me-1"></i> Ano, zrušit rezervaci
                            </button>
                            <a asp-page="Index" class="btn btn-outline-secondary btn-lg">
                                Zpět
                            </a>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@page
@model BistroStarsHollow.Web.Public.Pages.ReservationModel
@{
    ViewData["Title"] = "Rezervace";
}

<!-- Page Header -->
<section class="py-5 section-light">
    <div class="container">
        <h1 class="section-title section-title-center">Rezervace stolu</h1>
        <hr class="section-divider section-divider-center" />
        <p class="section-subtitle section-subtitle-center">
            Vyberte si datum, čas a stůl. Rezervace je bez přihlášení.
        </p>
    </div>
</section>

<!-- Reservation Content -->
<section class="py-5 section-white">
    <div class="container">
        <div class="row g-5">
            <!-- Table Selection -->
            <div class="col-lg-7">
                <div class="menu-card">
                    <h4 class="mb-4">
                        <i class="bi bi-grid-3x3 text-primary me-2"></i>
                        Dostupné stoly
                    </h4>

                    <div id="table-instructions" class="text-muted mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Nejprve vyplňte datum, čas a počet osob pro zobrazení dostupných stolů.
                    </div>

                    <div id="table-loading" class="text-center py-4 d-none">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Načítání...</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">Kontroluji dostupnost stolů...</p>
                    </div>

                    <div id="closed-warning" class="alert alert-warning d-none">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Zavřeno</strong> — Bistro je v tento den/čas zavřené. Vyberte prosím jiný termín.
                    </div>

                    <div id="table-grid" class="row g-3">
                        <!-- Tables loaded via AJAX -->
                    </div>

                    <!-- Legend -->
                    <div id="table-legend" class="d-flex gap-4 mt-3 flex-wrap d-none">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 16px; height: 16px; border-radius: 4px; background: var(--bistro-success);"></div>
                            <span class="small text-muted">Volný</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 16px; height: 16px; border-radius: 4px; background: #ef4444;"></div>
                            <span class="small text-muted">Obsazený</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div style="width: 16px; height: 16px; border-radius: 4px; background: var(--bistro-gold);"></div>
                            <span class="small text-muted">Vybraný</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reservation Form -->
            <div class="col-lg-5">
                <div class="menu-card">
                    <h4 class="mb-4">
                        <i class="bi bi-pencil-square text-primary me-2"></i>
                        Údaje pro rezervaci
                    </h4>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-1"></i> @Model.ErrorMessage
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form method="post" id="reservation-form">
                        <div class="mb-3">
                            <label asp-for="Input.FirstName" class="form-label fw-medium">Jméno <span class="text-danger">*</span></label>
                            <input asp-for="Input.FirstName" class="form-control" placeholder="Jan" />
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.LastName" class="form-label fw-medium">Příjmení <span class="text-danger">*</span></label>
                            <input asp-for="Input.LastName" class="form-control" placeholder="Novák" />
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Phone" class="form-label fw-medium">Telefon <span class="text-danger">*</span></label>
                            <input asp-for="Input.Phone" class="form-control" type="tel" placeholder="+420 000 000 000" />
                            <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label asp-for="Input.Date" class="form-label fw-medium">Datum <span class="text-danger">*</span></label>
                                <input asp-for="Input.Date" class="form-control" type="date" id="reservation-date" />
                                <span asp-validation-for="Input.Date" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Input.Time" class="form-label fw-medium">Čas <span class="text-danger">*</span></label>
                                <input asp-for="Input.Time" class="form-control" type="time" id="reservation-time" />
                                <span asp-validation-for="Input.Time" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.NumberOfPeople" class="form-label fw-medium">Počet osob <span class="text-danger">*</span></label>
                            <select asp-for="Input.NumberOfPeople" class="form-select" id="reservation-people">
                                <option value="">Vyberte počet osob</option>
                                @for (int i = 1; i <= 20; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                            <span asp-validation-for="Input.NumberOfPeople" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Vybraný stůl <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="selected-table-display" value="Zatím nevybrán" readonly />
                            <input asp-for="Input.TableId" type="hidden" id="selected-table-id" />
                            <span asp-validation-for="Input.TableId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Note" class="form-label fw-medium">Poznámka</label>
                            <textarea asp-for="Input.Note" class="form-control" rows="3" placeholder="Máte speciální přání?"></textarea>
                            <span asp-validation-for="Input.Note" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg" id="submit-btn" disabled>
                            <i class="bi bi-calendar-check me-1"></i> Odeslat rezervaci
                        </button>

                        <p class="text-muted small text-center mt-3 mb-0">
                            <i class="bi bi-shield-check me-1"></i>
                            Vaše údaje budou zpracovány v souladu s GDPR.
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Info -->
<section class="py-5 section-light">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="text-center">
                    <div class="bistro-card-icon mx-auto mb-3">
                        <i class="bi bi-clock"></i>
                    </div>
                    <h6>Rychlé potvrzení</h6>
                    <p class="text-muted small mb-0">
                        Rezervaci potvrdíme během otevírací doby.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <div class="bistro-card-icon mx-auto mb-3">
                        <i class="bi bi-x-circle"></i>
                    </div>
                    <h6>Snadné zrušení</h6>
                    <p class="text-muted small mb-0">
                        Rezervaci můžete zrušit pomocí odkazu v potvrzovací zprávě.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center">
                    <div class="bistro-card-icon mx-auto mb-3">
                        <i class="bi bi-telephone"></i>
                    </div>
                    <h6>Osobní přístup</h6>
                    <p class="text-muted small mb-0">
                        Preferujete telefon? Zavolejte nám na
                        <a href="tel:+420000000000" class="text-primary text-decoration-none">+420 000 000 000</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/reservation.js" asp-append-version="true"></script>
}

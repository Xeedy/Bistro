@page "{id:guid}"
@model BistroStarsHollow.Web.Admin.Pages.Operations.Tables.DeleteModel
@{
    ViewData["Title"] = "Smazat stůl";
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Zpět na seznam
    </a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="card-title mb-0">Opravdu smazat tento stůl?</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Název</dt>
                    <dd class="col-sm-8">@Model.BistroTable.Name</dd>
                    <dt class="col-sm-4">Kapacita</dt>
                    <dd class="col-sm-8">@Model.BistroTable.Capacity osob</dd>
                    <dt class="col-sm-4">Zóna</dt>
                    <dd class="col-sm-8">@(Model.BistroTable.Zone ?? "—")</dd>
                    <dt class="col-sm-4">Pozice</dt>
                    <dd class="col-sm-8">[@Model.BistroTable.MapX, @Model.BistroTable.MapY]</dd>
                    <dt class="col-sm-4">Stav</dt>
                    <dd class="col-sm-8">@(Model.BistroTable.IsActive ? "Aktivní" : "Neaktivní")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <form method="post">
                    <input type="hidden" asp-for="BistroTable.Id" />
                    <button type="submit" class="btn btn-danger">Smazat</button>
                </form>
                <a asp-page="Index" class="btn btn-outline-secondary">Zrušit</a>
            </div>
        </div>
    </div>
</div>

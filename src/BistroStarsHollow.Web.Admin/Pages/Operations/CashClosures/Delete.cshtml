@page "{id:guid}"
@model BistroStarsHollow.Web.Admin.Pages.Operations.CashClosures.DeleteModel
@{
    ViewData["Title"] = "Smazat uzávěrku";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Smazat uzávěrku</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-body">
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Opravdu chcete smazat tuto uzávěrku? Tato akce je nevratná.
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Datum</dt>
                    <dd class="col-sm-8">@Model.Closure.Date.ToString("dd.MM.yyyy")</dd>

                    <dt class="col-sm-4">Celkem</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Closure.TotalAmount.ToString("N2") Kč</dd>

                    <dt class="col-sm-4">Odchylka</dt>
                    <dd class="col-sm-8">@(Model.Closure.Difference >= 0 ? "+" : "")@Model.Closure.Difference.ToString("N2") Kč</dd>
                </dl>

                <hr />

                <form method="post" asp-route-id="@Model.Closure.Id">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Smazat</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Zrušit</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@page
@model BistroStarsHollow.Web.Admin.Pages.Operations.Reservations.IndexModel
@using BistroStarsHollow.Domain.Enums
@{
    ViewData["Title"] = "Rezervace";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Rezervace</h1>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Datum</label>
                <input type="date" name="FilterDate" value="@Model.FilterDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Stůl</label>
                <select name="FilterTableId" class="form-select">
                    <option value="">Všechny</option>
                    @foreach (var table in Model.Tables)
                    {
                        <option value="@table.Value" selected="@(Model.FilterTableId?.ToString() == table.Value)">@table.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Stav</label>
                <select name="FilterStatus" class="form-select">
                    <option value="">Všechny</option>
                    @foreach (var status in Model.Statuses)
                    {
                        <option value="@status.Value" selected="@(Model.FilterStatus.HasValue && ((int)Model.FilterStatus.Value).ToString() == status.Value)">@status.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Hledat</label>
                <input type="text" name="SearchPhrase" value="@Model.SearchPhrase" class="form-control" placeholder="Jméno nebo telefon..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Filtrovat</button>
            </div>
        </form>
    </div>
</div>

<!-- Desktop table -->
<div class="card d-none d-lg-block">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Čas</th>
                        <th>Jméno</th>
                        <th>Telefon</th>
                        <th>Osob</th>
                        <th>Stůl</th>
                        <th>Stav</th>
                        <th style="width:200px">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reservations)
                    {
                        <tr>
                            <td>@r.Date.ToString("dd.MM.yyyy")</td>
                            <td>@r.Time.ToString(@"hh\:mm")</td>
                            <td>@r.FullName</td>
                            <td>@r.Phone</td>
                            <td>@r.NumberOfPeople</td>
                            <td>@r.TableName</td>
                            <td><span class="badge @IndexModel.GetStatusBadgeClass(r.Status)">@IndexModel.GetStatusLabel(r.Status)</span></td>
                            <td>
                                <a asp-page="Detail" asp-route-id="@r.Id" class="btn btn-sm btn-outline-info me-1" title="Detail">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (r.Status == ReservationStatus.PendingConfirmation)
                                {
                                    <form method="post" asp-page-handler="Confirm" class="d-inline">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success me-1" title="Potvrdit">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                }
                                @if (r.Status == ReservationStatus.PendingConfirmation || r.Status == ReservationStatus.Confirmed)
                                {
                                    <form method="post" asp-page-handler="Cancel" class="d-inline">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger me-1" title="Zrušit">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                                @if (r.Status == ReservationStatus.Confirmed)
                                {
                                    <form method="post" asp-page-handler="Complete" class="d-inline">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary me-1" title="Dokončit">
                                            <i class="bi bi-check-all"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="NoShow" class="d-inline">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-dark" title="Nedostavení">
                                            <i class="bi bi-person-x"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Reservations.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Žádné rezervace odpovídající filtru.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Mobile/Tablet cards -->
<div class="d-lg-none">
    @foreach (var r in Model.Reservations)
    {
        <div class="card mb-2 item-card">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="fw-semibold">@r.FullName</div>
                        <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                            <small class="text-muted"><i class="bi bi-calendar me-1"></i>@r.Date.ToString("dd.MM.yyyy")</small>
                            <small class="text-muted"><i class="bi bi-clock me-1"></i>@r.Time.ToString(@"hh\:mm")</small>
                            <small class="text-muted"><i class="bi bi-people me-1"></i>@r.NumberOfPeople</small>
                            <small class="text-muted">@r.TableName</small>
                        </div>
                    </div>
                    <span class="badge @IndexModel.GetStatusBadgeClass(r.Status)" style="font-size:0.65rem;">@IndexModel.GetStatusLabel(r.Status)</span>
                </div>
                <div class="d-flex align-items-center gap-1 mt-2 border-top pt-2 flex-wrap">
                    <a asp-page="Detail" asp-route-id="@r.Id" class="btn btn-sm btn-outline-info" title="Detail">
                        <i class="bi bi-eye"></i>
                    </a>
                    @if (r.Status == ReservationStatus.PendingConfirmation)
                    {
                        <form method="post" asp-page-handler="Confirm" class="d-inline">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Potvrdit">
                                <i class="bi bi-check-lg"></i>
                            </button>
                        </form>
                    }
                    @if (r.Status == ReservationStatus.PendingConfirmation || r.Status == ReservationStatus.Confirmed)
                    {
                        <form method="post" asp-page-handler="Cancel" class="d-inline">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Zrušit">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    }
                    @if (r.Status == ReservationStatus.Confirmed)
                    {
                        <form method="post" asp-page-handler="Complete" class="d-inline">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Dokončit">
                                <i class="bi bi-check-all"></i>
                            </button>
                        </form>
                        <form method="post" asp-page-handler="NoShow" class="d-inline">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-dark" title="Nedostavení">
                                <i class="bi bi-person-x"></i>
                            </button>
                        </form>
                    }
                    <a href="tel:@r.Phone" class="btn btn-sm btn-outline-secondary ms-auto" title="Zavolat">
                        <i class="bi bi-telephone"></i>
                    </a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Reservations.Any())
    {
        <div class="text-center text-muted py-4">Žádné rezervace odpovídající filtru.</div>
    }
</div>

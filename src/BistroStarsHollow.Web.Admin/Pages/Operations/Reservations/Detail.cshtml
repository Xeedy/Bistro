@page "{id:guid}"
@model BistroStarsHollow.Web.Admin.Pages.Operations.Reservations.DetailModel
@using BistroStarsHollow.Domain.Enums
@{
    ViewData["Title"] = "Detail rezervace";

    string GetStatusLabel(ReservationStatus status) => status switch
    {
        ReservationStatus.PendingConfirmation => "Čeká na potvrzení",
        ReservationStatus.Confirmed => "Potvrzena",
        ReservationStatus.CancelledByUser => "Zrušena hostem",
        ReservationStatus.CancelledByAdmin => "Zrušena adminem",
        ReservationStatus.Completed => "Dokončena",
        ReservationStatus.NoShow => "Nedostavení",
        _ => status.ToString()
    };

    string GetStatusBadgeClass(ReservationStatus status) => status switch
    {
        ReservationStatus.PendingConfirmation => "bg-warning text-dark",
        ReservationStatus.Confirmed => "bg-success",
        ReservationStatus.CancelledByUser => "bg-secondary",
        ReservationStatus.CancelledByAdmin => "bg-danger",
        ReservationStatus.Completed => "bg-primary",
        ReservationStatus.NoShow => "bg-dark",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Detail rezervace</h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Zpět na seznam
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0">Informace o rezervaci</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Stav</dt>
                    <dd class="col-sm-8">
                        <span class="badge @GetStatusBadgeClass(Model.Reservation.Status)">@GetStatusLabel(Model.Reservation.Status)</span>
                    </dd>

                    <dt class="col-sm-4">Jméno</dt>
                    <dd class="col-sm-8">@Model.Reservation.FirstName @Model.Reservation.LastName</dd>

                    <dt class="col-sm-4">Telefon</dt>
                    <dd class="col-sm-8">@Model.Reservation.Phone</dd>

                    <dt class="col-sm-4">Datum</dt>
                    <dd class="col-sm-8">@Model.Reservation.Date.ToString("dd.MM.yyyy")</dd>

                    <dt class="col-sm-4">Čas</dt>
                    <dd class="col-sm-8">@Model.Reservation.Time.ToString(@"hh\:mm")</dd>

                    <dt class="col-sm-4">Počet osob</dt>
                    <dd class="col-sm-8">@Model.Reservation.NumberOfPeople</dd>

                    <dt class="col-sm-4">Stůl</dt>
                    <dd class="col-sm-8">@Model.Reservation.Table.Name</dd>

                    <dt class="col-sm-4">Poznámka</dt>
                    <dd class="col-sm-8">@(Model.Reservation.Note ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0">Systémové údaje</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">ID</dt>
                    <dd class="col-sm-7"><small class="text-muted">@Model.Reservation.Id</small></dd>

                    <dt class="col-sm-5">IP adresa</dt>
                    <dd class="col-sm-7">@(Model.Reservation.IpAddress ?? "—")</dd>

                    <dt class="col-sm-5">Cancel token</dt>
                    <dd class="col-sm-7"><small class="text-muted text-break">@Model.Reservation.CancelToken</small></dd>

                    <dt class="col-sm-5">Vytvořeno</dt>
                    <dd class="col-sm-7">@Model.Reservation.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                    <dt class="col-sm-5">Vytvořil</dt>
                    <dd class="col-sm-7">@(Model.Reservation.CreatedBy ?? "—")</dd>

                    <dt class="col-sm-5">Upraveno</dt>
                    <dd class="col-sm-7">@(Model.Reservation.ModifiedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</dd>

                    <dt class="col-sm-5">Upravil</dt>
                    <dd class="col-sm-7">@(Model.Reservation.ModifiedBy ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

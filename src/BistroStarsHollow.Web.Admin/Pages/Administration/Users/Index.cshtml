@page
@model BistroStarsHollow.Web.Admin.Pages.Administration.Users.IndexModel
@{
    ViewData["Title"] = "Uživatelé";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Uživatelé</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Přidat uživatele
    </a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mb-3">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <input type="text" name="SearchPhrase" value="@Model.SearchPhrase" class="form-control" placeholder="Hledat podle jména nebo e-mailu..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Hledat</button>
        </div>
    </form>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Jméno</th>
                        <th>E-mail</th>
                        <th>Role</th>
                        <th>Vytvořen</th>
                        <th>Stav</th>
                        <th style="width:160px">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    var badgeClass = role switch
                                    {
                                        "Superadmin" => "bg-danger",
                                        "Admin" => "bg-warning text-dark",
                                        "Employee" => "bg-info text-dark",
                                        _ => "bg-secondary"
                                    };
                                    <span class="badge @badgeClass me-1">@role</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                <form method="post" asp-page-handler="ToggleActive" class="d-inline">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-success" : "btn-secondary")">
                                        @(user.IsActive ? "Aktivní" : "Neaktivní")
                                    </button>
                                </form>
                            </td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Žádní uživatelé.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

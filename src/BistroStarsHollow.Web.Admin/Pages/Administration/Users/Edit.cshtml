@page "{id}"
@model BistroStarsHollow.Web.Admin.Pages.Administration.Users.EditModel
@{
    ViewData["Title"] = "Upravit uživatele";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Upravit uživatele</h1>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <p class="text-muted mb-3">E-mail: <strong>@Model.UserEmail</strong></p>

                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Input.Id" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.FirstName" class="form-label">Jméno</label>
                            <input asp-for="Input.FirstName" class="form-control" />
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.LastName" class="form-label">Příjmení</label>
                            <input asp-for="Input.LastName" class="form-control" />
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label">Nové heslo (volitelné)</label>
                        <input asp-for="Input.NewPassword" class="form-control" type="password" placeholder="Ponechte prázdné pro zachování stávajícího" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Input.SelectedRoles" value="@role" id="role_@role"
                                       checked="@(Model.Input.SelectedRoles.Contains(role))" />
                                <label class="form-check-label" for="role_@role">@role</label>
                            </div>
                        }
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Input.IsActive" class="form-check-input" />
                        <label asp-for="Input.IsActive" class="form-check-label">Aktivní účet</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Uložit</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Zrušit</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@page
@model BistroStarsHollow.Web.Admin.Pages.Administration.AuditLog.IndexModel
@{
    ViewData["Title"] = "Audit log";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Audit log</h1>
    <span class="text-muted">Celkem @Model.TotalCount záznamů</span>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Akce</label>
                <input type="text" name="FilterAction" value="@Model.FilterAction" class="form-control" placeholder="Např. Create, Update..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Od</label>
                <input type="date" name="FilterFrom" value="@Model.FilterFrom?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Do</label>
                <input type="date" name="FilterTo" value="@Model.FilterTo?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filtrovat</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead>
                    <tr>
                        <th>Čas</th>
                        <th>Uživatel</th>
                        <th>Akce</th>
                        <th>Entita</th>
                        <th>ID entity</th>
                        <th>Detail</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td class="text-nowrap">@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td>@(log.UserName ?? "—")</td>
                            <td><span class="badge bg-secondary">@log.Action</span></td>
                            <td>@log.EntityType</td>
                            <td><small class="text-muted">@(log.EntityId ?? "—")</small></td>
                            <td><small>@(log.Details ?? "—")</small></td>
                            <td><small class="text-muted">@(log.IpAddress ?? "—")</small></td>
                        </tr>
                    }
                    @if (!Model.Logs.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Žádné záznamy.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="Index" asp-route-currentPage="@(Model.CurrentPage - 1)"
                       asp-route-filterAction="@Model.FilterAction" asp-route-filterFrom="@Model.FilterFrom?.ToString("yyyy-MM-dd")"
                       asp-route-filterTo="@Model.FilterTo?.ToString("yyyy-MM-dd")">Předchozí</a>
                </li>
            }
            @for (var i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-page="Index" asp-route-currentPage="@i"
                       asp-route-filterAction="@Model.FilterAction" asp-route-filterFrom="@Model.FilterFrom?.ToString("yyyy-MM-dd")"
                       asp-route-filterTo="@Model.FilterTo?.ToString("yyyy-MM-dd")">@i</a>
                </li>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="Index" asp-route-currentPage="@(Model.CurrentPage + 1)"
                       asp-route-filterAction="@Model.FilterAction" asp-route-filterFrom="@Model.FilterFrom?.ToString("yyyy-MM-dd")"
                       asp-route-filterTo="@Model.FilterTo?.ToString("yyyy-MM-dd")">Další</a>
                </li>
            }
        </ul>
    </nav>
}

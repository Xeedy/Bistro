@page
@model BistroStarsHollow.Web.Admin.Pages.Content.Events.IndexModel
@{
    ViewData["Title"] = "Akce";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Akce</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Přidat akci
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Název</th>
                        <th>Od</th>
                        <th>Do</th>
                        <th>Stav</th>
                        <th style="width:120px">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in Model.Events)
                    {
                        <tr>
                            <td>@evt.Title</td>
                            <td>@(evt.ValidFrom?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td>@(evt.ValidTo?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td>
                                @if (evt.IsActive)
                                {
                                    <span class="badge bg-success">Aktivní</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Neaktivní</span>
                                }
                            </td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Events.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Zatím žádné akce.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@page
@model BistroStarsHollow.Web.Admin.Pages.Content.Events.IndexModel
@{
    ViewData["Title"] = "Akce";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Akce</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Přidat akci
    </a>
</div>

@Html.AntiForgeryToken()

<!-- Desktop table -->
<div class="card d-none d-lg-block">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Název</th>
                        <th>Od</th>
                        <th>Do</th>
                        <th>Stav</th>
                        <th style="width:120px">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in Model.Events)
                    {
                        <tr>
                            <td>@evt.Title</td>
                            <td>@(evt.ValidFrom?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td>@(evt.ValidTo?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td>
                                <input type="checkbox" class="form-check-input item-active-toggle"
                                       data-id="@evt.Id"
                                       @(evt.IsActive ? "checked" : "")
                                       title="@(evt.IsActive ? "Deaktivovat" : "Aktivovat")" />
                            </td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Events.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Zatím žádné akce.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Mobile/Tablet cards -->
<div class="d-lg-none">
    @foreach (var evt in Model.Events)
    {
        <div class="card mb-2 item-card">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@evt.Title</div>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <small class="text-muted">
                                @(evt.ValidFrom?.ToString("dd.MM.yyyy") ?? "—") — @(evt.ValidTo?.ToString("dd.MM.yyyy") ?? "—")
                            </small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <input type="checkbox" class="form-check-input item-active-toggle"
                               data-id="@evt.Id"
                               @(evt.IsActive ? "checked" : "") />
                        <a asp-page="Edit" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-page="Delete" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Events.Any())
    {
        <div class="text-center text-muted py-4">Zatím žádné akce.</div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            document.querySelectorAll('.item-active-toggle').forEach(cb => {
                cb.addEventListener('change', function () {
                    const id = this.dataset.id, checkbox = this;
                    fetch('?handler=ToggleActive', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                        body: 'id=' + encodeURIComponent(id)
                    }).then(r => r.json()).then(data => { if (data.success) { document.querySelectorAll('.item-active-toggle[data-id="' + id + '"]').forEach(c => c.checked = data.isActive); } })
                      .catch(() => { checkbox.checked = !checkbox.checked; });
                });
            });
        })();
    </script>
}

@page "{id:guid}"
@model BistroStarsHollow.Web.Admin.Pages.Content.ContentBlocks.DeleteModel
@{
    ViewData["Title"] = "Smazat textový blok";
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Zpět na seznam
    </a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="card-title mb-0">Opravdu smazat tento textový blok?</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Klíč</dt>
                    <dd class="col-sm-8"><code>@Model.Block.Key</code></dd>
                    <dt class="col-sm-4">Titulek</dt>
                    <dd class="col-sm-8">@Model.Block.Title</dd>
                    <dt class="col-sm-4">Jazyk</dt>
                    <dd class="col-sm-8">@Model.Block.Language.ToUpper()</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <form method="post">
                    <input type="hidden" asp-for="Block.Id" />
                    <button type="submit" class="btn btn-danger">Smazat</button>
                </form>
                <a asp-page="Index" class="btn btn-outline-secondary">Zrušit</a>
            </div>
        </div>
    </div>
</div>

@page
@model BistroStarsHollow.Web.Admin.Pages.Content.Slides.IndexModel
@{
    ViewData["Title"] = "Hero Slider";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Hero Slider</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Přidat nový
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:80px">Náhled</th>
                        <th>Titulek</th>
                        <th>URL odkaz</th>
                        <th>Pořadí</th>
                        <th>Stav</th>
                        <th style="width:120px">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slide in Model.Slides)
                    {
                        <tr>
                            <td>
                                <img src="@slide.ImagePath" alt="@slide.Title" class="img-thumbnail" style="width:60px;height:40px;object-fit:cover;" />
                            </td>
                            <td>@slide.Title</td>
                            <td><small class="text-muted">@slide.LinkUrl</small></td>
                            <td>@slide.SortOrder</td>
                            <td>
                                @if (slide.IsActive)
                                {
                                    <span class="badge bg-success">Aktivní</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Neaktivní</span>
                                }
                            </td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@slide.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@slide.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Slides.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Zatím žádné slidy.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

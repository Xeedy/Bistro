@page "{id:guid}"
@model BistroStarsHollow.Web.Admin.Pages.Content.Menu.DeleteModel
@{
    ViewData["Title"] = "Smazat položku menu";
}

@{
    string CategoryName(MenuCategory cat) => cat switch
    {
        MenuCategory.Food => "Jídlo",
        MenuCategory.ColdDrinks => "Studené nápoje",
        MenuCategory.Beer => "Pivo",
        MenuCategory.Tea => "Čaj",
        MenuCategory.WaterPipes => "Vodní dýmky",
        MenuCategory.Products => "Produkty",
        _ => cat.ToString()
    };
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Zpět na seznam
    </a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="card-title mb-0">Opravdu smazat tuto položku menu?</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Název</dt>
                    <dd class="col-sm-8">@Model.MenuItem.Name</dd>
                    <dt class="col-sm-4">Kategorie</dt>
                    <dd class="col-sm-8">@CategoryName(Model.MenuItem.Category)</dd>
                    <dt class="col-sm-4">Cena</dt>
                    <dd class="col-sm-8">@(Model.MenuItem.DisplayPrice ?? Model.MenuItem.Price?.ToString("0.00 Kč") ?? "—")</dd>
                    <dt class="col-sm-4">Stav</dt>
                    <dd class="col-sm-8">@(Model.MenuItem.IsActive ? "Aktivní" : "Neaktivní")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <form method="post">
                    <input type="hidden" asp-for="MenuItem.Id" />
                    <button type="submit" class="btn btn-danger">Smazat</button>
                </form>
                <a asp-page="Index" class="btn btn-outline-secondary">Zrušit</a>
            </div>
        </div>
    </div>
</div>

@page
@model BistroStarsHollow.Web.Admin.Pages.Content.Menu.CreateModel
@{
    ViewData["Title"] = "Nová položka menu";
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Zpět na seznam
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Nová položka menu</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MenuItem.Name" class="form-label">Název <span class="text-danger">*</span></label>
                        <input asp-for="MenuItem.Name" class="form-control" required />
                        <span asp-validation-for="MenuItem.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MenuItem.Category" class="form-label">Kategorie</label>
                        <select asp-for="MenuItem.Category" class="form-select">
                            <option value="@MenuCategory.Food">Jídlo</option>
                            <option value="@MenuCategory.ColdDrinks">Studené nápoje</option>
                            <option value="@MenuCategory.Beer">Pivo</option>
                            <option value="@MenuCategory.Tea">Čaj</option>
                            <option value="@MenuCategory.WaterPipes">Vodní dýmky</option>
                            <option value="@MenuCategory.Products">Produkty</option>
                        </select>
                        <span asp-validation-for="MenuItem.Category" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MenuItem.Price" class="form-label">Cena</label>
                            <input asp-for="MenuItem.Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="MenuItem.Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MenuItem.DisplayPrice" class="form-label">Zobrazovaná cena</label>
                            <input asp-for="MenuItem.DisplayPrice" class="form-control" placeholder="např. od 50 Kč" />
                            <div class="form-text">Volitelné. Přepíše číselnou cenu.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MenuItem.Description" class="form-label">Popis</label>
                        <textarea asp-for="MenuItem.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="MenuItem.Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MenuItem.SortOrder" class="form-label">Pořadí</label>
                            <input asp-for="MenuItem.SortOrder" class="form-control" type="number" />
                            <span asp-validation-for="MenuItem.SortOrder" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="MenuItem.IsActive" class="form-check-input" />
                        <label asp-for="MenuItem.IsActive" class="form-check-label">Aktivní</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Uložit</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Zrušit</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

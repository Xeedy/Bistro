@page
@model BistroStarsHollow.Web.Admin.Pages.Content.Beers.IndexModel
@{
    ViewData["Title"] = "Piva";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Piva</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Přidat pivo
    </a>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(string.IsNullOrEmpty(Model.Type) ? "active" : "")" asp-page="Index">Všechna</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Type == "Draft" ? "active" : "")" asp-page="Index" asp-route-type="Draft">Čepovaná</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Type == "Bottled" ? "active" : "")" asp-page="Index" asp-route-type="Bottled">Lahvová</a>
    </li>
</ul>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Název</th>
                        <th>Typ</th>
                        <th>Styl</th>
                        <th>Pivovar</th>
                        <th>Cena</th>
                        <th>Pořadí</th>
                        <th>Stav</th>
                        <th style="width:120px">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var beer in Model.Beers)
                    {
                        <tr>
                            <td>@beer.Name</td>
                            <td>
                                @if (beer.Type == BeerType.Draft)
                                {
                                    <span class="badge bg-primary">Čepované</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">Lahvové</span>
                                }
                            </td>
                            <td>@(beer.Style ?? "—")</td>
                            <td>@(beer.Brewery?.Name ?? "—")</td>
                            <td>@beer.Price.ToString("0.00 Kč")</td>
                            <td>@beer.SortOrder</td>
                            <td>
                                @if (beer.IsActive)
                                {
                                    <span class="badge bg-success">Aktivní</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Neaktivní</span>
                                }
                            </td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@beer.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@beer.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Beers.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Zatím žádná piva.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@page
@model BistroStarsHollow.Web.Admin.Pages.Content.Beers.CreateModel
@{
    ViewData["Title"] = "Nové pivo";
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Zpět na seznam
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Nové pivo</h5>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Beer.Name" class="form-label">Název <span class="text-danger">*</span></label>
                        <input asp-for="Beer.Name" class="form-control" required />
                        <span asp-validation-for="Beer.Name" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Beer.Type" class="form-label">Typ</label>
                            <select asp-for="Beer.Type" class="form-select">
                                <option value="@BeerType.Draft">Čepované</option>
                                <option value="@BeerType.Bottled">Lahvové</option>
                            </select>
                            <span asp-validation-for="Beer.Type" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Beer.Style" class="form-label">Styl</label>
                            <input asp-for="Beer.Style" class="form-control" placeholder="např. Ležák, IPA, APA" />
                            <span asp-validation-for="Beer.Style" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Beer.Price" class="form-label">Cena <span class="text-danger">*</span></label>
                            <input asp-for="Beer.Price" class="form-control" type="number" step="0.01" required />
                            <span asp-validation-for="Beer.Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Beer.BreweryId" class="form-label">Pivovar <span class="text-danger">*</span></label>
                            <select asp-for="Beer.BreweryId" class="form-select" required>
                                <option value="">— Vyberte pivovar —</option>
                                @foreach (var brewery in Model.Breweries)
                                {
                                    <option value="@brewery.Id">@brewery.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Beer.BreweryId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Beer.Description" class="form-label">Popis</label>
                        <textarea asp-for="Beer.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Beer.Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Obrázek</label>
                        <input type="file" name="ImageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">Volitelné. Max 5 MB.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Beer.SortOrder" class="form-label">Pořadí</label>
                            <input asp-for="Beer.SortOrder" class="form-control" type="number" />
                            <span asp-validation-for="Beer.SortOrder" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Beer.IsActive" class="form-check-input" />
                        <label asp-for="Beer.IsActive" class="form-check-label">Aktivní</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Uložit</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Zrušit</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

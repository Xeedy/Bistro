@page
@model BistroStarsHollow.Web.Admin.Pages.Content.Breweries.IndexModel
@{
    ViewData["Title"] = "Pivovary";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Pivovary</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Přidat pivovar
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:60px">Logo</th>
                        <th>Název</th>
                        <th>Počet piv</th>
                        <th>Pořadí</th>
                        <th>Stav</th>
                        <th style="width:120px">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var brewery in Model.Breweries)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(brewery.LogoImagePath))
                                {
                                    <img src="@brewery.LogoImagePath" alt="@brewery.Name" class="img-thumbnail" style="max-height:40px; max-width:50px;" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@brewery.Name</td>
                            <td>@(Model.BeerCounts.GetValueOrDefault(brewery.Id, 0))</td>
                            <td>@brewery.SortOrder</td>
                            <td>
                                @if (brewery.IsActive)
                                {
                                    <span class="badge bg-success">Aktivní</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Neaktivní</span>
                                }
                            </td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@brewery.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@brewery.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Breweries.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Zatím žádné pivovary.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

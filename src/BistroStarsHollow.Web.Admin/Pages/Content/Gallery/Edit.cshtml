@page "{id:guid}"
@model BistroStarsHollow.Web.Admin.Pages.Content.Gallery.EditModel
@{
    ViewData["Title"] = "Upravit obrázek";
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Zpět na galerii
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Upravit obrázek</h5>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Image.Id" />
                    <input type="hidden" asp-for="Image.FilePath" />
                    <input type="hidden" asp-for="Image.FileName" />
                    <input type="hidden" asp-for="Image.CreatedAt" />
                    <input type="hidden" asp-for="Image.CreatedBy" />

                    <div class="mb-3">
                        <label class="form-label">Obrázek</label>
                        @if (!string.IsNullOrEmpty(Model.Image.FilePath))
                        {
                            <div class="mb-2">
                                <img src="@Model.Image.FilePath" alt="@Model.Image.AltText" class="img-thumbnail" style="max-height:150px;" />
                            </div>
                        }
                        <input type="file" name="ImageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">Ponechte prázdné pro zachování stávajícího obrázku.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Image.AltText" class="form-label">Alt text</label>
                        <input asp-for="Image.AltText" class="form-control" />
                        <span asp-validation-for="Image.AltText" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Image.SortOrder" class="form-label">Pořadí</label>
                        <input asp-for="Image.SortOrder" class="form-control" type="number" />
                        <span asp-validation-for="Image.SortOrder" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Image.IsActive" class="form-check-input" />
                        <label asp-for="Image.IsActive" class="form-check-label">Aktivní</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Uložit změny</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Zrušit</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@page
@model BistroStarsHollow.Web.Admin.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Profil";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Můj profil</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Profile info -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body text-center py-4">
                <div class="mb-3">
                    <i class="bi bi-person-circle" style="font-size: 4rem; color: var(--bistro-primary);"></i>
                </div>
                <h5 class="mb-1">@Model.FullName</h5>
                <p class="text-muted small mb-2">@Model.Email</p>
                <div class="d-flex gap-1 justify-content-center flex-wrap">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge @(role == "Superadmin" ? "bg-danger" : role == "Admin" ? "bg-primary" : "bg-secondary")">@role</span>
                    }
                </div>
                <hr />
                <div class="text-muted small">
                    <i class="bi bi-calendar3 me-1"></i> Registrován: @Model.CreatedAt.ToString("dd.MM.yyyy")
                </div>
            </div>
        </div>
    </div>

    <!-- Edit forms -->
    <div class="col-lg-8">
        <!-- Update profile -->
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-person me-2"></i>Osobní údaje</h6>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="UpdateProfile">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Jméno</label>
                            <input type="text" class="form-control" asp-for="FirstName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Příjmení</label>
                            <input type="text" class="form-control" asp-for="LastName" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">E-mail</label>
                            <input type="email" class="form-control" value="@Model.Email" disabled />
                            <div class="form-text">E-mail nelze měnit.</div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Uložit změny
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Change password -->
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Změna hesla</h6>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="ChangePassword">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Aktuální heslo</label>
                            <input type="password" class="form-control" asp-for="CurrentPassword" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nové heslo</label>
                            <input type="password" class="form-control" asp-for="NewPassword" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Potvrzení nového hesla</label>
                            <input type="password" class="form-control" asp-for="ConfirmPassword" />
                        </div>
                    </div>
                    <div class="form-text mb-3">
                        Heslo musí mít alespoň 8 znaků, velké i malé písmeno, číslici a speciální znak.
                    </div>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-key me-1"></i> Změnit heslo
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-bookmark-check"></i>
                </div>
                <div>
                    <div class="text-muted small">Dnešní rezervace</div>
                    <div class="fs-4 fw-bold">@Model.TodayReservationCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-cup-straw"></i>
                </div>
                <div>
                    <div class="text-muted small">Aktivní čepovaná</div>
                    <div class="fs-4 fw-bold">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-calendar3"></i>
                </div>
                <div>
                    <div class="text-muted small">Moje směny tento týden</div>
                    <div class="fs-4 fw-bold">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-megaphone"></i>
                </div>
                <div>
                    <div class="text-muted small">Aktivní akce</div>
                    <div class="fs-4 fw-bold">0</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0">Nadcházející rezervace</h6>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingReservations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Čas</th>
                                    <th>Jméno</th>
                                    <th>Osob</th>
                                    <th>Stůl</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.UpcomingReservations)
                                {
                                    <tr>
                                        <td>@r.Date.ToString("dd.MM.")</td>
                                        <td>@r.Time.ToString(@"hh\:mm")</td>
                                        <td>@r.FullName</td>
                                        <td>@r.NumberOfPeople</td>
                                        <td>@r.TableName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0 p-3">Žádné nadcházející rezervace.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0">Rychlé akce</h6>
            </div>
            <div class="card-body d-grid gap-2">
                <a asp-page="/Operations/Reservations/Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-bookmark-check me-1"></i>Správa rezervací</a>
                <a asp-page="/Content/Menu/Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-card-list me-1"></i>Upravit menu</a>
                <a asp-page="/Content/Beers/Index" asp-route-type="Draft" class="btn btn-outline-primary btn-sm"><i class="bi bi-cup-straw me-1"></i>Správa piv</a>
                <a asp-page="/Content/Gallery/Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-images me-1"></i>Nahrát fotky</a>
            </div>
        </div>
    </div>
</div>

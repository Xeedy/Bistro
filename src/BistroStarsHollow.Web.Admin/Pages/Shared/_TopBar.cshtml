@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

<header class="app-topbar">
    <div class="topbar-left">
        <button class="btn-sidebar-toggle d-lg-none" id="sidebarToggle" aria-label="Toggle sidebar">
            <i class="bi bi-list"></i>
        </button>
        <nav aria-label="breadcrumb" class="topbar-breadcrumb">
            <span class="text-muted">@ViewData["Title"]</span>
        </nav>
    </div>

    <div class="topbar-right">
        <div class="lang-switch d-flex align-items-center gap-1 me-2">
            <a class="lang-pill @(currentCulture == "cs" ? "active" : "")" href="?culture=cs">CZ</a>
            <a class="lang-pill @(currentCulture == "en" ? "active" : "")" href="?culture=en">EN</a>
        </div>

        <div class="dropdown">
            <button class="btn btn-topbar-user dropdown-toggle" type="button" id="userDropdown"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-1"></i>
                <span class="d-none d-md-inline">@User.Identity?.Name</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                <li><a class="dropdown-item" asp-page="/Account/Profile"><i class="bi bi-person me-2"></i>Profil</a></li>
                <li><a class="dropdown-item" asp-page="/Account/Profile"><i class="bi bi-gear me-2"></i>Nastavení</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-page="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Odhlásit</a></li>
            </ul>
        </div>
    </div>
</header>

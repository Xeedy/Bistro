@using BistroStarsHollow.Domain.Constants
@inject BistroStarsHollow.Application.Common.Interfaces.IAdminReservationService AdminReservationService
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var pendingReservationCount = await AdminReservationService.GetPendingReservationCountAsync();
}

<aside class="app-sidebar" id="sidebar">
    <div class="sidebar-header">
        <a href="/" class="sidebar-brand">
            <span class="sidebar-brand-text">Bistro SH</span>
        </a>
        <button class="btn-sidebar-close d-lg-none" id="sidebarClose" aria-label="Zavřít menu">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <nav class="sidebar-nav">
        <div class="sidebar-section">
            <span class="sidebar-section-title">Hlavní</span>
            <ul class="sidebar-menu">
                <li>
                    <a class="sidebar-link @(currentPage == "/Index" || currentPage == "/" ? "active" : "")" asp-page="/Index">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
            </ul>
        </div>

        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Superadmin))
        {
            <div class="sidebar-section">
                <span class="sidebar-section-title">Správa obsahu</span>
                <ul class="sidebar-menu">
                    <li>
                        <a class="sidebar-link @(currentPage.Contains("/Content/Slides") ? "active" : "")" asp-page="/Content/Slides/Index">
                            <i class="bi bi-sliders2"></i>
                            <span>Hero Slider</span>
                        </a>
                    </li>
                    @{
                        var isProductsOpen = currentPage.Contains("/Content/Menu") || currentPage.Contains("/Content/DraftBeers") || currentPage.Contains("/Content/BottledBeers");
                    }
                    <li>
                        <a class="sidebar-link sidebar-submenu-toggle @(isProductsOpen ? "open" : "")" href="#" data-submenu="productsSubmenu">
                            <i class="bi bi-basket3"></i>
                            <span>Produkty</span>
                            <i class="bi bi-chevron-down ms-auto sidebar-chevron"></i>
                        </a>
                        <ul class="sidebar-submenu @(isProductsOpen ? "show" : "")" id="productsSubmenu">
                            <li>
                                <a class="sidebar-link @(currentPage.Contains("/Content/Menu") ? "active" : "")" asp-page="/Content/Menu/Index">
                                    <i class="bi bi-card-list"></i>
                                    <span>Menu</span>
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentPage.Contains("/Content/DraftBeers") ? "active" : "")" asp-page="/Content/DraftBeers/Index">
                                    <i class="bi bi-cup-straw"></i>
                                    <span>Čepovaná piva</span>
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-link @(currentPage.Contains("/Content/BottledBeers") ? "active" : "")" asp-page="/Content/BottledBeers/Index">
                                    <i class="bi bi-box-seam"></i>
                                    <span>Lahvová piva</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <a class="sidebar-link @(currentPage.Contains("/Content/BeerStyles") ? "active" : "")" asp-page="/Content/BeerStyles/Index">
                            <i class="bi bi-tags"></i>
                            <span>Pivní styly</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @(currentPage.Contains("/Content/Breweries") ? "active" : "")" asp-page="/Content/Breweries/Index">
                            <i class="bi bi-building"></i>
                            <span>Pivovary</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @(currentPage.Contains("/Content/Gallery") ? "active" : "")" asp-page="/Content/Gallery/Index">
                            <i class="bi bi-images"></i>
                            <span>Galerie</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @(currentPage.Contains("/Content/Events") ? "active" : "")" asp-page="/Content/Events/Index">
                            <i class="bi bi-megaphone"></i>
                            <span>Akce</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @(currentPage.Contains("/Content/ContentBlocks") ? "active" : "")" asp-page="/Content/ContentBlocks/Index">
                            <i class="bi bi-file-text"></i>
                            <span>Textové bloky</span>
                        </a>
                    </li>
                </ul>
            </div>
        }

        <div class="sidebar-section">
            <span class="sidebar-section-title">Provoz</span>
            <ul class="sidebar-menu">
                <li>
                    <a class="sidebar-link @(currentPage.Contains("/Operations/Shifts") ? "active" : "")" asp-page="/Operations/Shifts/Index">
                        <i class="bi bi-calendar3"></i>
                        <span>Směny</span>
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(currentPage.Contains("/Operations/Reservations") ? "active" : "")" asp-page="/Operations/Reservations/Index">
                        <i class="bi bi-bookmark-check"></i>
                        <span>Rezervace</span>
                        @if (pendingReservationCount > 0)
                        {
                            <span class="badge bg-warning text-dark ms-auto">@pendingReservationCount</span>
                        }
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(currentPage.Contains("/Operations/CashClosures") ? "active" : "")" asp-page="/Operations/CashClosures/Index">
                        <i class="bi bi-cash-stack"></i>
                        <span>Uzávěrka</span>
                    </a>
                </li>
            </ul>
        </div>

        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Superadmin))
        {
            <div class="sidebar-section">
                <span class="sidebar-section-title">Administrace</span>
                <ul class="sidebar-menu">
                    <li>
                        <a class="sidebar-link @(currentPage.Contains("/Administration/Users") ? "active" : "")" asp-page="/Administration/Users/Index">
                            <i class="bi bi-people"></i>
                            <span>Uživatelé</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @(currentPage.Contains("/Content/OpeningHours") ? "active" : "")" asp-page="/Content/OpeningHours/Index">
                            <i class="bi bi-clock-history"></i>
                            <span>Otevírací doba</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @(currentPage.Contains("/Administration/AuditLog") ? "active" : "")" asp-page="/Administration/AuditLog/Index">
                            <i class="bi bi-journal-text"></i>
                            <span>Audit log</span>
                        </a>
                    </li>
                </ul>
            </div>
        }

        @if (User.IsInRole(Roles.Superadmin))
        {
            <div class="sidebar-section">
                <span class="sidebar-section-title">Systém</span>
                <ul class="sidebar-menu">
                    <li>
                        <a class="sidebar-link" href="#">
                            <i class="bi bi-shield-lock"></i>
                            <span>Systémový log</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link" href="#">
                            <i class="bi bi-bar-chart"></i>
                            <span>Analytika</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="sidebar-user-avatar">
                <i class="bi bi-person-circle"></i>
            </div>
            <div class="sidebar-user-info">
                <span class="sidebar-user-name">@User.Identity?.Name</span>
                <span class="sidebar-user-role">
                    @if (User.IsInRole(Roles.Superadmin)) { <text>Superadmin</text> }
                    else if (User.IsInRole(Roles.Admin)) { <text>Administrátor</text> }
                    else if (User.IsInRole(Roles.Employee)) { <text>Zaměstnanec</text> }
                </span>
            </div>
        </div>
    </div>
</aside>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
